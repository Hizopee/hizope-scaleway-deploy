# Copie en ".env" sur la VPS Gaia (jamais commité).
# Gaia a sa propre instance Managed PostgreSQL DEV-S, dédiée (pas partagée
# avec CMicrolocks/LoveList) — format Npgsql. Le nom de base "GaiaDb" (avec
# cette casse) est celui déjà utilisé dans GaiaWebApi/appsettings.json,
# à respecter exactement :
#   Host=<host-db-gaia>;Port=5432;Database=GaiaDb;Username=<user>;Password=<password>;Ssl Mode=Require

GAIA_DB_CONNECTION=Host=;Port=5432;Database=GaiaDb;Username=;Password=;Ssl Mode=Require
GAIA_JWT_KEY=

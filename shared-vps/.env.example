# Copie en ".env" sur la VPS partagée (jamais commité).
#
# Rangé PAR APPLICATION, puis production / intégration. Pour remettre ton vrai .env dans
# cet ordre sans perdre une valeur : scripts/trier-env.sh (ne fait qu'écrire .env.trie, à
# relire puis renommer toi-même).
#
# Mots de passe et clés aléatoires : `openssl rand -hex 24` (hexadécimal, rien à échapper)
# ou `openssl rand -base64 48` quand c'est précisé.
# Chaînes de connexion Npgsql :
#   Host=postgres;Port=5432;Database=<nom>;Username=<user>;Password=<password>

########################################################################################
#                                     CMICROLOCKS                                      #
########################################################################################

# ---------- CMicrolocks · production (api.cmicrolocks.fr) ----------------------------

# Nom de base "Microlocks" (casse à respecter). scripts/migrate-db.sh met cette ligne à jour.
CMICROLOCKS_DB_CONNECTION=Host=postgres;Port=5432;Database=Microlocks;Username=cmicrolocks;Password=
CMICROLOCKS_JWT_KEY=

# Twilio — SMS réels. Console Twilio > Account SID + Auth Token. FROM = expéditeur
# alphanumérique "CMICROLOCKS" (pas de numéro à louer).
CMICROLOCKS_TWILIO_ACCOUNT_SID=
CMICROLOCKS_TWILIO_AUTH_TOKEN=
CMICROLOCKS_TWILIO_FROM=CMICROLOCKS

# Stripe — compte plateforme Hizope, mode LIVE.
#   SECRET / PUBLISHABLE : Dashboard Stripe (mode live) > Développeurs > Clés API
#     (sk_live_... / pk_live_...). Clé secrète complète : Connect en a besoin.
#   WEBHOOK : Développeurs > Webhooks > Ajouter une destination, « Votre compte »,
#     URL https://api.cmicrolocks.fr/api/payments/stripe-webhook, événements
#     checkout.session.completed, checkout.session.expired,
#     checkout.session.async_payment_failed > révéler le « Signing secret » (whsec_...).
CMICROLOCKS_STRIPE_SECRET_KEY=
CMICROLOCKS_STRIPE_PUBLISHABLE_KEY=
CMICROLOCKS_STRIPE_WEBHOOK_SECRET=
#   WEBHOOK CONNECT (acomptes payés directement au salon) : 2e destination, « Comptes
#     connectés », même URL et mêmes événements > son propre « Signing secret ».
CMICROLOCKS_STRIPE_CONNECT_WEBHOOK_SECRET=
# Stripe Connect (acomptes versés au salon, commission 10 % retenue pour Hizope) : true
# une fois Connect activé en mode live.
CMICROLOCKS_USE_CONNECT=false

# Firebase — notifications push. JSON du compte de service (Firebase Console > Paramètres
# du projet > Comptes de service > Générer une nouvelle clé privée), minifié sur une
# ligne, ENTOURÉ DE GUILLEMETS SIMPLES.
CMICROLOCKS_FIREBASE_KEY_JSON=

# Emails (Scaleway Transactional Email, domaine cmicrolocks.fr vérifié).
# USERNAME = ID du projet Scaleway ; PASSWORD = Secret Key d'une clé API IAM dédiée
# (TransactionalEmailFullAccess, limitée au projet).
CMICROLOCKS_SMTP_USERNAME=
CMICROLOCKS_SMTP_PASSWORD=

# Clé partagée avec Hizope-pilotage (routes api/platform/*), même valeur des deux côtés.
CMICROLOCKS_PLATFORM_KEY=

# ---------- CMicrolocks · intégration (int.cmicrolocks.fr / admin-int) ---------------
# Base SÉPARÉE "Microlocks_Integration", données de démo uniquement. Voir
# INTEGRATION-CMICROLOCKS.md.

CMICROLOCKS_INT_DB_CONNECTION=Host=postgres;Port=5432;Database=Microlocks_Integration;Username=cmicrolocks_int;Password=
CMICROLOCKS_INT_JWT_KEY=
# Mot de passe du compte admin de démo (admin@microlocks.local) : à donner à Cécilia.
CMICROLOCKS_INT_ADMIN_PASSWORD=

# Stripe — mode TEST uniquement (jamais de clé live ici). Sans clés : paiement simulé.
#   Même chemin que la prod, mais dashboard en mode test (sk_test_... / pk_test_...).
#   WEBHOOK : URL https://int.cmicrolocks.fr/api/payments/stripe-webhook, mêmes événements.
CMICROLOCKS_INT_STRIPE_SECRET_KEY=
CMICROLOCKS_INT_STRIPE_PUBLISHABLE_KEY=
CMICROLOCKS_INT_STRIPE_WEBHOOK_SECRET=
#   WEBHOOK CONNECT test : 2e destination « Comptes connectés », même URL, mêmes événements.
CMICROLOCKS_INT_STRIPE_CONNECT_WEBHOOK_SECRET=
# true une fois les trois clés test renseignées.
CMICROLOCKS_INT_USE_REAL_PAYMENTS=false
# Stripe Connect en mode test (avec CMICROLOCKS_INT_USE_REAL_PAYMENTS=true).
CMICROLOCKS_INT_USE_CONNECT=false

########################################################################################
#                                       LOVELIST                                       #
########################################################################################

# ---------- LoveList · production (api.lovelist.shop) ---------------------------------

# Nom de base "LoveListDb" (casse à respecter).
LOVELIST_DB_CONNECTION=Host=postgres;Port=5432;Database=LoveListDb;Username=;Password=
# Signature des jetons de connexion : `openssl rand -base64 48`.
LOVELIST_JWT_KEY=
# Accès à l'espace admin (en-tête X-Admin-Key).
LOVELIST_ADMIN_KEY=

# Sources externes (vide = source désactivée, l'API démarre quand même).
LOVELIST_TMDB_API_KEY=
LOVELIST_OMDB_API_KEY=
LOVELIST_IGDB_CLIENT_ID=
LOVELIST_IGDB_CLIENT_SECRET=
LOVELIST_GOOGLE_BOOKS_API_KEY=
LOVELIST_STEAM_API_KEY=

# Stripe — abonnement Premium, compte Stripe de LoveList, mode LIVE.
#   SECRET : Développeurs > Clés API (sk_live_...).
#   WEBHOOK : Développeurs > Webhooks > Ajouter une destination, « Votre compte »,
#     URL https://api.lovelist.shop/api/billing/stripe-webhook, événements
#     checkout.session.completed, customer.subscription.updated,
#     customer.subscription.deleted > « Signing secret » (whsec_...).
#   PRICE : Catalogue de produits > « LoveList Premium » (mode LIVE) > id price_... des prix
#     mensuel (4,99 €) et annuel (49,90 €). Un id de prix test ne marche pas en live :
#     recrée les prix en live, ou « Copier en mode production » depuis le produit test.
LOVELIST_STRIPE_SECRET_KEY=
LOVELIST_STRIPE_WEBHOOK_SECRET=
LOVELIST_STRIPE_PRICE_MONTHLY=
LOVELIST_STRIPE_PRICE_YEARLY=

# Emails (Scaleway Transactional Email). Vides = les emails sont seulement écrits dans les
# journaux. PROJECT_ID = ID du projet Scaleway ; SECRET_KEY = clé API IAM dédiée.
LOVELIST_EMAIL_SECRET_KEY=
LOVELIST_EMAIL_PROJECT_ID=
LOVELIST_EMAIL_FROM_ADDRESS=

# Clé partagée avec Hizope-pilotage (logs), même valeur des deux côtés.
LOVELIST_PLATFORM_KEY=

# ---------- LoveList · intégration (api-int.lovelist.shop) ----------------------------
# Base SÉPARÉE "LoveListDb_Integration". Stripe en mode TEST uniquement, avec ses propres
# id de prix test (jamais ceux de la prod).

LOVELIST_INT_DB_CONNECTION=Host=postgres;Port=5432;Database=LoveListDb_Integration;Username=;Password=
LOVELIST_INT_JWT_KEY=
#   WEBHOOK test : URL https://api-int.lovelist.shop/api/billing/stripe-webhook, mêmes événements.
LOVELIST_INT_STRIPE_SECRET_KEY=
LOVELIST_INT_STRIPE_WEBHOOK_SECRET=
LOVELIST_INT_STRIPE_PRICE_MONTHLY=
LOVELIST_INT_STRIPE_PRICE_YEARLY=

########################################################################################
#                                  HIZOPE PILOTAGE                                     #
########################################################################################

# Hash bcrypt (PAS le mot de passe) du Basic Auth qui protège le Pilotage :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'un-mot-de-passe-fort'
HIZOPE_PILOTAGE_BASIC_AUTH_HASH=

# Clés Stripe RESTREINTES en lecture seule (Développeurs > Clés API > Créer une clé
# restreinte), jamais les clés complètes ci-dessus. Une paire live + test par compte.
#   CMicrolocks (compte Hizope) : Charges = Lecture.
HIZOPE_PILOTAGE_STRIPE_SECRET_KEY=
HIZOPE_PILOTAGE_STRIPE_TEST_SECRET_KEY=
#   LoveList : Charges, Balance, Payouts = Lecture.
HIZOPE_PILOTAGE_LOVELIST_STRIPE_SECRET_KEY=
HIZOPE_PILOTAGE_LOVELIST_STRIPE_TEST_SECRET_KEY=

########################################################################################
#                                         GAIA                                         #
########################################################################################

# Voir MIGRATION-GAIA.md (scripts/migrate-db.sh gaia remplace GAIA_DB_CONNECTION).
GAIA_DB_CONNECTION=
GAIA_JWT_KEY=
GAIA_PG_PASSWORD=
# Clé partagée avec Hizope-pilotage (modération). Vide = modération en 503.
GAIA_PLATFORM_KEY=

########################################################################################
#                            LAZULITTERAIRE (revision.hizope.fr)                       #
########################################################################################

# Voir LAZULITTERAIRE.md. REVISION_AUTH_SECRET : `openssl rand -base64 48`, à CONSERVER
# (le changer invalide tous les codes d'accès). REVISION_ANTHROPIC_API_KEY : facultatif.
REVISION_PG_PASSWORD=
REVISION_DB_CONNECTION=Host=postgres;Port=5432;Database=revision;Username=revision_app;Password=
REVISION_AUTH_SECRET=
REVISION_ANTHROPIC_API_KEY=

########################################################################################
#                       INFRASTRUCTURE (PostgreSQL, sauvegardes)                       #
########################################################################################

# PostgreSQL auto-hébergé (voir MIGRATION-POSTGRES.md). Ne JAMAIS changer ces valeurs après
# le premier démarrage : elles ne sont lues qu'à la création des bases.
POSTGRES_PASSWORD=
CMICROLOCKS_PG_PASSWORD=
LOVELIST_PG_PASSWORD=
LOVELIST_INT_PG_PASSWORD=

# Sauvegardes quotidiennes vers Scaleway Object Storage (fr-par). Clé API d'une application
# IAM dédiée (ObjectStorageFullAccess, limitée au projet).
BACKUP_S3_BUCKET=mhq-db-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

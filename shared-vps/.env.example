# Copie en ".env" sur la VPS partagée (jamais commité).
# CMicrolocks et LoveList partagent la VPS (compute) mais ont chacune leur
# propre instance Managed PostgreSQL DEV-S dédiée — format Npgsql :
#   Host=<host-db-app>;Port=5432;Database=<nom>;Username=<user>;Password=<password>;Ssl Mode=Require

CMICROLOCKS_DB_CONNECTION=Host=;Port=5432;Database=cmicrolocks;Username=;Password=;Ssl Mode=Require
CMICROLOCKS_JWT_KEY=

# LoveList utilise le nom de base "LoveListDb" (casse à respecter, déjà en
# place dans LoveList-backend/appsettings.json).
LOVELIST_DB_CONNECTION=Host=;Port=5432;Database=LoveListDb;Username=;Password=;Ssl Mode=Require

# Clés externes utilisées par LoveList (voir ExternalApis/ dans le repo) —
# à demander/récupérer séparément, pas liées à la migration DB :
# LOVELIST_TMDB_API_KEY=
# LOVELIST_OMDB_API_KEY=
# LOVELIST_IGDB_CLIENT_ID=
# LOVELIST_IGDB_CLIENT_SECRET=
# LOVELIST_GOOGLE_BOOKS_API_KEY=

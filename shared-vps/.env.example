# Copie en ".env" sur la VPS partagée (jamais commité).
# CMicrolocks et LoveList partagent la VPS (compute) mais ont chacune leur
# propre instance Managed PostgreSQL DEV-S dédiée — format Npgsql :
#   Host=<host-db-app>;Port=5432;Database=<nom>;Username=<user>;Password=<password>;Ssl Mode=Require

# CMicrolocks utilise le nom de base "Microlocks" (casse à respecter, celui
# déjà en place dans src/Microlocks.Api/appsettings.json — pas "cmicrolocks").
CMICROLOCKS_DB_CONNECTION=Host=;Port=5432;Database=Microlocks;Username=;Password=;Ssl Mode=Require
CMICROLOCKS_JWT_KEY=

# Twilio (HIZ-193) — SMS réels (rappels/confirmations RDV). Console Twilio > Account
# SID + Auth Token. FROM = expéditeur alphanumérique "CMICROLOCKS" (pas de numéro à
# louer — voir docs/DEPLOIEMENT.md du repo CMicrolocks-client-web §Twilio).
CMICROLOCKS_TWILIO_ACCOUNT_SID=
CMICROLOCKS_TWILIO_AUTH_TOKEN=
CMICROLOCKS_TWILIO_FROM=CMICROLOCKS

# LoveList utilise le nom de base "LoveListDb" (casse à respecter, déjà en
# place dans LoveList-backend/appsettings.json).
LOVELIST_DB_CONNECTION=Host=;Port=5432;Database=LoveListDb;Username=;Password=;Ssl Mode=Require

# Clés externes utilisées par LoveList (voir ExternalApis/ dans le repo) —
# à demander/récupérer séparément, pas liées à la migration DB.
# Laisser vide si non fournie : l'API LoveList démarre quand même (source
# désactivée). Open Library ne demande pas de clé (API publique gratuite).
LOVELIST_TMDB_API_KEY=
LOVELIST_OMDB_API_KEY=
LOVELIST_IGDB_CLIENT_ID=
LOVELIST_IGDB_CLIENT_SECRET=
LOVELIST_GOOGLE_BOOKS_API_KEY=

# Clé d'accès à l'espace admin de LoveList (en-tête X-Admin-Key).
LOVELIST_ADMIN_KEY=

# HIZ-229 — Hizope-pilotage (tableau de bord interne, Joyce uniquement, sur cmicrlocks.fr).
# Clé partagée entre CMicrolocks-backend (Platform:PilotageKey) et Hizope-pilotage-api
# (CMicrolocks:PlatformKey) pour les routes api/platform/* — génère une valeur aléatoire
# longue, la même des deux côtés (ex: openssl rand -hex 24).
CMICROLOCKS_PLATFORM_KEY=

# Hash bcrypt (PAS le mot de passe en clair) du compte HTTP Basic Auth qui protège tout
# cmicrlocks.fr. Générer avec :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'un-mot-de-passe-fort'
HIZOPE_PILOTAGE_BASIC_AUTH_HASH=

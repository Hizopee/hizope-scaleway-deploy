api.cmicrolocks.fr {
    reverse_proxy cmicrolocks-api:8080
}

admin.cmicrolocks.fr {
    handle /api/* {
        reverse_proxy cmicrolocks-api:8080
    }
    handle {
        root * /srv/admin-website
        try_files {path} /index.html
        file_server
    }
}

cmicrolocks.fr, www.cmicrolocks.fr {
    # Site de réservation (SPA Vue, repo CMicrolocks-client-web) servi en statique.
    # /api et /hubs sont proxifiés vers l'API sur ce même domaine pour que les appels
    # relatifs du front + SignalR fonctionnent sans CORS.
    handle /api/* {
        reverse_proxy cmicrolocks-api:8080
    }
    handle /hubs/* {
        reverse_proxy cmicrolocks-api:8080
    }
    # Photos servies par le backend (galerie, chat, photos de référence).
    handle /uploads/* {
        reverse_proxy cmicrolocks-api:8080
    }
    handle {
        root * /srv/cmicrolocks-website
        try_files {path} /index.html
        file_server
    }
}

api.lovelist.shop {
    reverse_proxy lovelist-api:8080
}

lovelist.shop, www.lovelist.shop {
    root * /srv/lovelist-website
    try_files {path} /index.html
    file_server
}
